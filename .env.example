# Optional server-side fallbacks. Prefer keys pasted in Settings.
# Never commit a real key. The server uses an env value only when the browser did not send one.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENROUTER_API_KEY=

# Embeddings always use OpenAI (text-embedding-3-small).
# Chat can use OpenRouter when the Settings provider is OpenRouter.

FIRECRAWL_API_KEY=
LLAMA_CLOUD_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

PINECONE_API_KEY=
PINECONE_HOST=

ZOTERO_API_KEY=
ZOTERO_USER_ID=

# pgvector. Start it with: docker compose up -d
# When this is unset, embeddings are stored in data/indexes.
DATABASE_URL=postgres://lumina:lumina@127.0.0.1:54329/lumina

TECTONIC_BIN=
LUMINA_DATA_DIR=
